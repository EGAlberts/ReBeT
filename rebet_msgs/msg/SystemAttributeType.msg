# These types correspond to the value that is set in the SystemAttributeValue message.


# Default value, which implies this is not a valid parameter.

uint8 ATTRIBUTE_NOT_SET=0

uint8 ATTRIBUTE_ODOM=1

uint8 ATTRIBUTE_DIAG=2

uint8 ATTRIBUTE_LASER=3

uint8 ATTRIBUTE_FLOAT=4

uint8 ATTRIBUTE_RANGE=5

uint8 ATTRIBUTE_BATTERY=6
